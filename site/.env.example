# ============================================================
# متغيرات بيئة التطوير المحلي (لا تُرفع أبدًا لأي مستودع Git)
# ============================================================

# مفتاح Supabase العام (Anon Key) - آمن نسبيًا للكشف طالما RLS مفعّلة بصرامة
VITE_SUPABASE_URL="MY_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# مفتاح Gemini API - يُستخدم فقط داخل api/gemini-chat.ts على الخادم.
# لا تضف له بادئة VITE_ إطلاقًا، وإلا سيُضمَّن في حزمة المتصفح ويُكشف للجميع.
# على Vercel: أضِفه من Project Settings → Environment Variables باسم GEMINI_API_KEY
GEMINI_API_KEY="MY_GEMINI_API_KEY"
